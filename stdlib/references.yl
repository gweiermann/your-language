import { error } from "core/diagnostics"
import { ancestors, contribute, find, get, getEarlier, getAll, hasMultiple, isPresent, text } from "core/query"

export symbol scope

export symbol declarations

export symbol referenceIdentity

export symbol reassignableSymbol

export operation createLexicalScope(target) {
    contribute((target, scope), target)
}

export operation enclosingScope(value) = find(ancestors(value), ancestor => get((ancestor, scope)))

export operation resolve(name) = find(ancestors(name), ancestor => getEarlier((get((ancestor, scope)), declarations, text(name))))

export operation declareName(target, name, reassignable = true) {
    contribute((enclosingScope(name), declarations, text(name)), target)
    contribute((name, referenceIdentity), target)
    contribute((target, referenceIdentity), target)
    contribute((target, nameSymbol), text(name))
    contribute((target, reassignableSymbol), reassignable)
    when isPresent(enclosingScope(name)) {
        when hasMultiple(getAll((enclosingScope(name), declarations, text(name)))) {
            error("Duplicate declaration '${name}'", name)
        }
    }
    else {
        error("Declaration has no lexical scope", name)
    }
}

export operation connectReference(target, name) {
    ref := resolve(name)
    contribute((name, referenceIdentity), ref)
    contribute((target, referenceIdentity), ref)
    when !isPresent(ref) {
        error("Unknown name '${name}'", name)
    }
    return ref
}

export operation referenceOf(value) = get((value, referenceIdentity))

export symbol nameSymbol
