import { ancestors, contribute, find, get, getEarlier, getAll, hasMultiple, isPresent, text, first, children } from "std/query"

export symbol scope

export symbol declarations

export symbol referenceIdentity

export symbol reassignableSymbol

export operation lexicalScope() {
    contribute((self, scope), self)
}

export operation enclosingScope(value) = find(ancestors(value), ancestor => get((ancestor, scope)))

export operation resolve(name) = find(ancestors(name), ancestor => getEarlier((get((ancestor, scope)), declarations, text(name))))

export operation declare(name, reassignable = true) {
    contribute((enclosingScope(name), declarations, text(name)), self)
    contribute((name, referenceIdentity), self)
    contribute((self, referenceIdentity), self)
    contribute((self, nameSymbol), text(name))
    contribute((self, reassignableSymbol), reassignable)
    if isPresent(enclosingScope(name)) {
        if hasMultiple(getAll((enclosingScope(name), declarations, text(name)))) {
            error("Duplicate declaration '${name}'", name)
        }
    }
    else {
        error("Declaration has no lexical scope", name)
    }
}

export operation use(name) {
    contribute((name, referenceIdentity), resolve(name))
    contribute((self, referenceIdentity), resolve(name))
    if !isPresent(resolve(name)) {
        error("Unknown name '${name}'", name)
    }
}

export operation reference() = get((self, referenceIdentity))

export operation referenceOf(value) = get((value, referenceIdentity))

export symbol nameSymbol

export operation identity() = self

export operation identityOf(value) = value

export operation childIdentity() = first(children(self))

export operation identities(value) = value
