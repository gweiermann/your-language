import { Name } from "./name";
import { Expression } from "./expression";

export relation Variable on Name {
    relation Let {
        trait variable(mutable=true)
    }

    relation Const {
        trait variable(mutable=false)
    }
}

export node VariableDeclaration =
    kind: ("let" | "const")
    name: Name
    ("=" initializer: Expression)?;
