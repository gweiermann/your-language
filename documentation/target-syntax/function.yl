import { separatedBy } from "std/parser";
import { Name } from "./name";
import { Expression } from "./expression";
import { VariableDeclaration } from "./variable";

node Parameter =
    name: Name
    ("=" default: Expression)?;

export pattern Parameters =
    Parameter*
    |> separatedBy(",", trailing=.optional);

pattern BlockStatement =
    VariableDeclaration
    | ReturnStatement
    | Expression;

export node Block =
    "{"
    statements: BlockStatement*
    "}";

export relation Function on Name {
}

export node FunctionDeclaration =
    "function"
    name: Name
    "(" parameters: Parameters ")"
    body: Block;

export node ReturnStatement =
    "return"
    value: Expression?;
