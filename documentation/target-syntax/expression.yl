import { separatedBy } from "std/parser";
import { Name } from "./name";

node String =
    value: /"(?:\\.|[^"])*"/;

node Number =
    value: /\d+(?:\.\d+)?/;

export expression Expression {
    atom String;
    atom Number;
    atom Name;
    atom "(" Expression ")";

    postfix Member =
        "." property: Name;

    postfix Call =
        "("
        arguments: Expression*
            |> separatedBy(",", trailing=.optional)
        ")";

    prefix Unary =
        operator: ("+" | "-" | "!");

    infix Product =
        operator: ("*" | "/");

    infix Sum =
        operator: ("+" | "-");
}
