import { declareName, createLexicalScope, connectReference } from "./references"
import { Name } from "./lexical"

export node Statement {
    node Declaration =
        "let"
        name: Name
        ";"
    {
        semantics {
            declareName(self, name)
        }
    }

    node Reference =
        name: Name
        ";"
    {
        semantics {
            connectReference(self, name)
        }
    }

    node Block =
        "{"
        statements: Statement*
        "}"
    {
        semantics {
            boundary
            createLexicalScope(self)
            precedence {
                Statement::Declaration > Statement::Reference
            }
        }
    }
}
