import { error } from "core/diagnostics"
import { choose, equal, isPresent, lookup, map, text, zip } from "core/query"
import { connectReference } from "std/references"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { inheritType, checkUniqueFields } from "./types"
import { Type, Comparison, annotateWithType, typeOf, restrictWritesTo, writeTypeOf, numberType, stringType, booleanType, tupleType, listType, structType, unionType, compareTypes, reportDifference } from "./typing"

node Number = value: /[0-9]+/ {
    ide {
        highlightAs "number"
    }
    semantics {
        annotateWithType(self, numberType())
    }
}

node String = value: /"[^"\n]*"/ {
    ide {
        highlightAs "string"
    }
    semantics {
        annotateWithType(self, stringType())
    }
}

node Boolean = value: /true|false/ {
    ide {
        highlightAs "keyword"
    }
    semantics {
        annotateWithType(self, booleanType())
    }
}

node Reference = name: Name {
    semantics {
        ref := connectReference(self, name)
        annotateWithType(self, typeOf(ref))
        restrictWritesTo(self, writeTypeOf(ref))
    }
}

node Tuple =
    "("
    items: Expression* |> separatedBy(",")
    ")"
{
    semantics {
        annotateWithType(self, tupleType(map(items, item => typeOf(item))))
    }
}

node List =
    "["
    items: Expression* |> separatedBy(",")
    "]"
{
    semantics {
        annotateWithType(self, listType(unionType(map(items, item => typeOf(item)))))
    }
}

node ObjectField =
    name: Name
    ":"
    value: Expression

node Object =
    "{"
    fields: ObjectField* |> separatedBy(",")
    "}"
{
    semantics {
        // Pair field names with their inferred types.
        checkUniqueFields(fields.name)
        annotateWithType(self, structType(map(zip(fields.name, fields.value), field => (text(field[0]), typeOf(field[1])))))
    }
}

node Member =
    base: Expression
    "."
    name: Name
{
    semantics {
        parent := typeOf(base)
        selected := choose(equal(parent[0], Type::struct), lookup(parent[1], text(name)), absent)
        when isPresent(selected) {
            annotateWithType(self, selected)
            contract := writeTypeOf(base)
            fieldContract := choose(equal(contract[0], Type::struct), lookup(contract[1], text(name)), absent)
            restrictWritesTo(self, choose(isPresent(fieldContract), fieldContract, selected))
        }
        else {
            error("Property '${name}' does not exist on this type", [(name, "unknown property")])
        }
    }
}

node Index =
    base: Expression
    "["
    index: /[0-9]+/
    "]"
{
    semantics {
        descriptor := typeOf(base)
        when equal(descriptor[0], Type::list) {
            annotateWithType(self, descriptor[1])
            contract := writeTypeOf(base)
            restrictWritesTo(self, choose(equal(contract[0], Type::list), contract[1], descriptor[1]))
        }
        else {
            error("Only homogeneous list types support this index expression", [(index, absent)])
        }
    }
}

export node Expression {
    node Member

    node Index

    node Tuple

    node List

    node Object

    node Boolean

    node Number

    node String

    node Reference

    precedence {
        Member, Index
    }

    semantics {
        inheritType(self)
    }
}

export node Assignment =
    target: Expression
    "="
    value: Expression
    ";"
{
    semantics {
        differences := compareTypes(typeOf(value), writeTypeOf(target), Comparison::assignable)
        when isPresent(differences[0]) {
            reportDifference(differences[0], value)
        }
    }
}

export node ExpressionStatement =
    value: Expression
    ";"
