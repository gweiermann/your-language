import { error } from "core/diagnostics"
import { annotateWithType, typeOf, restrictTypeTo, resolveTypeWith, compatible, unknown } from "std/types"
import { referenceOf, enclosingScope } from "std/references"
import { get, contribute, children, first, last, find, map, zip, lookup, text, equal, isPresent, choose, every, values, filter, flatten, alternatives } from "core/query"
import { parameters, parameterNames, parameterAnnotations, parameterSources, returnType, declaredReturnType, functionIdentity } from "./types"

export operation inheritType(target) {
    annotateWithType(target, typeOf(first(children(target))))
}

export operation bindingType(name, value, annotation = absent) {
    annotateWithType(referenceOf(name), typeOf(value))
    restrictTypeTo(referenceOf(name), typeOf(annotation), value, annotation.value)
    annotateWithType(name, typeOf(referenceOf(name)))
}

operation functionOf(target) = get((enclosingScope(target), functionIdentity))

export operation parameterType(target, name, annotation) {
    annotateWithType((functionOf(target), parameters, text(name)), typeOf(annotation))
    annotateWithType(referenceOf(name), typeOf((functionOf(target), parameters, text(name))))
    annotateWithType(name, typeOf(referenceOf(name)))
}

export operation functionSignature(name, arguments, body, annotation, contents) {
    annotateWithType(referenceOf(name), referenceOf(name))
    annotateWithType(name, referenceOf(name))
    contribute((contents, functionIdentity), referenceOf(name))
    contribute((referenceOf(name), parameterNames), map(arguments.name, name => text(name)))
    contribute((referenceOf(name), parameterAnnotations), map(arguments.annotation, annotation => typeOf(annotation)))
    contribute((referenceOf(name), parameterSources), arguments.annotation.value)
    annotateWithType((referenceOf(name), parameters), zip(map(arguments.name, parameter => text(parameter)), map(arguments.name, parameter => typeOf((referenceOf(name), parameters, text(parameter))))))
    annotateWithType((referenceOf(name), returnType), choose(isPresent(annotation), typeOf(annotation), typeOf((body, returnType))))
    contribute((referenceOf(name), declaredReturnType), choose(isPresent(annotation), typeOf(annotation), absent))
    restrictTypeTo((body, returnType), typeOf(annotation), body.result, annotation.value)
}

operation sameLength(left, right) = equal(map(left, value => true), map(right, value => true))

operation assumptions(function, arguments) = map(zip(get((function, parameterNames)), arguments), pair => ((function, parameters, first(pair)), typeOf(last(pair)), last(pair)))

operation requiredType(function, arguments, argument) = lookup(zip(arguments, get((function, parameterAnnotations))), argument)

operation requiredAnnotation(function, arguments, argument) = lookup(zip(arguments, get((function, parameterSources))), argument)

operation invalidArgument(function, arguments) = find(arguments, argument => choose(compatible(typeOf(argument), requiredType(function, arguments, argument)), absent, argument))

operation functionsOf(callee) = filter(values(typeOf(callee)), candidate => isPresent(get((candidate, parameterNames))))

operation validFunctions(callee, arguments) = filter(functionsOf(callee), function => sameLength(get((function, parameterNames)), arguments))

operation invalidFunction(callee, arguments) = find(validFunctions(callee, arguments), function => choose(isPresent(invalidArgument(function, arguments)), function, absent))

operation declaredResult(function) = get((function, declaredReturnType))

operation callResult(function, arguments) = choose(isPresent(declaredResult(function)), declaredResult(function), resolveTypeWith((function, returnType), assumptions(function, arguments)))

operation restrictArgument(function, arguments, argument) {
    restrictTypeTo(argument, requiredType(function, arguments, argument), argument, requiredAnnotation(function, arguments, argument))
}

export operation call(target, callee, arguments) {
    when !every(values(typeOf(callee)), candidate => choose(equal(candidate, unknown), true, isPresent(get((candidate, parameterNames))))) {
        error("Expression is not callable", callee)
    }
    when !every(functionsOf(callee), function => sameLength(get((function, parameterNames)), arguments)) {
        error("Wrong number of arguments", callee)
    }
    restrictArgument(invalidFunction(callee, arguments), arguments, invalidArgument(invalidFunction(callee, arguments), arguments))
    annotateWithType(target, alternatives(flatten(map(validFunctions(callee, arguments), function => values(callResult(function, arguments))))))
}
