import { error } from "core/diagnostics"
import { connectReference } from "std/references"
import { call, inheritType } from "./typing"
import { annotateWithType, typeOf } from "std/types"
import { unknown } from "std/types"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { Type } from "./types"

node Reference = name: Name {
    semantics {
        ref := connectReference(self, name)
        annotateWithType(self, typeOf(ref))
        annotateWithType(name, typeOf(ref))
    }
}

node Call =
    callee: Reference
    "("
    arguments: Expression* |> separatedBy(",")
    ")"
{
    semantics {
        call(self, callee, arguments)
    }
}

node Number = value: /[0-9]+/ {
    ide {
        highlightAs "number"
    }
    semantics {
        annotateWithType(self, Type::number)
    }
}

node String = value: /"[^"\n]*"/ {
    ide {
        highlightAs "string"
    }
    semantics {
        annotateWithType(self, Type::string)
    }
}

node Boolean = value: /true|false/ {
    ide {
        highlightAs "keyword"
    }
    semantics {
        annotateWithType(self, Type::boolean)
    }
}

node Addition =
    left: Expression
    "+"
    right: Expression
{
    semantics {
        match (typeOf(left), typeOf(right)) {
            Type::string, Type::string | Type::string, Type::number | Type::number, Type::string => annotateWithType(self, Type::string),
            Type::number, Type::number                                                           => annotateWithType(self, Type::number),
            unknown, _ | _, unknown                                                              => annotateWithType(self, unknown),
            _                                                                                    => error("${left} + ${right} is not possible")
        }
    }
}

export node Expression {
    node Addition

    node Call

    node Boolean

    node Number

    node String

    node Reference

    semantics {
        inheritType(self)
    }
}
