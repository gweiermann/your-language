import { boundedBy } from "std/parser"

export trivia Whitespace = /[ \t\r\n]+/

export trivia Comment = /\/\/[^\n]*/

export node Name = /[a-zA-Z_][a-zA-Z_0-9]*/ {
    ide {
        highlightAs "variable"
    }
}

pattern IdentifierPart = /[a-zA-Z_0-9]/

export pattern keyword(value) = value |> boundedBy(IdentifierPart) {
    ide {
        highlightAs "keyword"
    }
}
