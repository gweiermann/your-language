import { createLexicalScope } from "std/references"
import { checkInteger } from "./typing"
import { program } from "std/backend/integer"
import { Whitespace, Comment, keyword } from "./lexical"
import { Expression } from "./expression"
import { Statement } from "./statement"

node Program =
    statements: Statement*
    keyword("result")
    result: Expression
    ";"
{
    semantics {
        boundary
        createLexicalScope(self)
        checkInteger(result)
    }
    backend {
        program(statements, result)
    }
}

entry Program {
    trivia Whitespace, Comment
}
