import { number, reference, add, multiply, less } from "std/backend/integer"
import { annotateWithType, typeOf } from "std/types"
import { connectReference } from "std/references"
import { Type, inheritType, integerBinary } from "./typing"
import { Name } from "./lexical"

node Number = value: /[0-9]+/ {
    ide {
        highlightAs "number"
    }
    semantics {
        annotateWithType(self, Type::integer)
    }
    backend {
        number(value)
    }
}

node Reference = name: Name {
    semantics {
        ref := connectReference(self, name)
        annotateWithType(self, typeOf(ref))
    }
    backend {
        reference(name)
    }
}

node Addition =
    left: Expression
    "+"
    right: Expression
{
    semantics {
        integerBinary(self, left, right)
    }
    backend {
        add(left, right)
    }
}

node Multiplication =
    left: Expression
    "*"
    right: Expression
{
    semantics {
        integerBinary(self, left, right)
    }
    backend {
        multiply(left, right)
    }
}

node Less =
    left: Expression
    "<"
    right: Expression
{
    semantics {
        integerBinary(self, left, right)
    }
    backend {
        less(left, right)
    }
}

export node Expression {
    semantics {
        inheritType(self)
    }
    node Number

    node Reference

    node Addition

    node Multiplication

    node Less

    precedence {
        Multiplication > Addition > Less
    }
}
