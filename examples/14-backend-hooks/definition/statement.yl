import { annotateWithType, typeOf, restrictTypeTo } from "std/types"
import { createLexicalScope, declareName, connectReference } from "std/references"
import { Annotation, checkInteger } from "./typing"
import { declare, assign, block, conditional, repeat } from "std/backend/integer"
import { Name, keyword } from "./lexical"
import { Expression } from "./expression"

node Declaration =
    keyword("let")
    name: Name
    annotation: Annotation?
    "="
    initializer: Expression
    ";"
{
    semantics {
        declareName(self, name)
        annotateWithType(self, typeOf(initializer))
        restrictTypeTo(initializer, typeOf(annotation), initializer, annotation.value)
    }
    backend {
        declare(name, initializer)
    }
}

node Assignment =
    name: Name
    "="
    value: Expression
    ";"
{
    semantics {
        ref := connectReference(self, name)
        restrictTypeTo(value, typeOf(ref))
    }
    backend {
        assign(name, value)
    }
}

node Block =
    "{"
    statements: Statement*
    "}"
{
    semantics {
        boundary
        createLexicalScope(self)
    }
    backend {
        block(statements)
    }
}

node Conditional =
    keyword("if")
    "("
    condition: Expression
    ")"
    yes: Block
    keyword("else")
    no: Block
{
    semantics {
        checkInteger(condition)
    }
    backend {
        conditional(condition, yes, no)
    }
}

node Repeat =
    keyword("while")
    "("
    condition: Expression
    ")"
    body: Block
{
    semantics {
        checkInteger(condition)
    }
    backend {
        repeat(condition, body)
    }
}

export node Statement {
    node Declaration

    node Assignment

    node Block

    node Conditional

    node Repeat
}
