import { declare, variable } from "std/variables"
import { annotate, typeof, ensure } from "./typing"
import { Name } from "./lexical"
import { Annotation } from "./types"
import { Expression } from "./expression"

export node LetDeclaration =
    "let"
    name: Name
    annotation: Annotation?
    "="
    initializer: Expression
    ";"
{
    meanings {
        group Register {
            declare(variable, name)
            annotate(typeof(initializer))
            ensure(annotation)
        }
    }
}
