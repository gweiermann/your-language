import { use } from "std/references"
import { annotateWithType, typeof, call, inheritType, referenceType } from "./typing"
import { unknown } from "std/types"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { number, string, boolean } from "./types"

node Reference = name: Name {
    meanings {
        use(self, name)
        referenceType(self, name)
    }
}

node Call =
    callee: Reference
    "("
    arguments: Expression* |> separatedBy(",")
    ")"
{
    meanings {
        call(self, callee, arguments)
    }
}

node Number = value: /[0-9]+/ {
    meanings {
        annotateWithType(self, number)
    }
}

node String = value: /"[^"\n]*"/ {
    meanings {
        annotateWithType(self, string)
    }
}

node Boolean = value: /true|false/ {
    meanings {
        annotateWithType(self, boolean)
    }
}

node Addition =
    left: Expression
    "+"
    right: Expression
{
    meanings {
        match (typeof(left), typeof(right)) {
            string, string | string, number | number, string => annotateWithType(self, string),
            number, number                                   => annotateWithType(self, number),
            unknown, _ | _, unknown                          => annotateWithType(self, unknown),
            _                                                => error("${left} + ${right} is not possible")
        }
    }
}

export node Expression {
    node Addition

    node Call

    node Boolean

    node Number

    node String

    node Reference

    meanings {
        inheritType(self)
    }
}
