import { use } from "std/variables"
import { annotate, typeof, call, inherit } from "./typing"
import { unknown } from "std/types"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { number, string, boolean } from "./types"

node Reference = name: Name {
    meanings {
        use(name)
    }
}

node Call =
    callee: Reference
    "("
    arguments: Expression* |> separatedBy(",")
    ")"
{
    meanings {
        call(callee, arguments)
    }
}

node Number = value: /[0-9]+/ {
    meanings {
        annotate(number)
    }
}

node String = value: /"[^"\n]*"/ {
    meanings {
        annotate(string)
    }
}

node Boolean = value: /true|false/ {
    meanings {
        annotate(boolean)
    }
}

node Addition =
    left: Expression
    "+"
    right: Expression
{
    meanings {
        match (typeof(left), typeof(right)) {
            string, string | string, number | number, string => annotate(string),
            number, number => annotate(number),
            unknown, _ | _, unknown => annotate(unknown),
            _ => error("${left} + ${right} is not possible")
        }
    }
}

export node Expression {

    node Addition

    node Call

    node Boolean

    node Number

    node String

    node Reference precedence {
        Addition
    }
    meanings {
        inherit()
    }
}
