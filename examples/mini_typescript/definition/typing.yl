import * as types from "std/types"
import { referenceOf } from "std/references"
import * as syntax from "std/syntax"
import { Function, parameters, returnType } from "./types"

export operation annotateWithType(value) {
    types::annotate(self, value)
}

export operation typeof(value) = types::typeof(value)

export operation inheritType() {
    types::annotate(self, types::typeof(syntax::childIdentity()))
}

export operation restrictTypeTo(value) {
    types::restrictTo(self, typeof(value))
}

export operation bindingType(name, value, annotation = absent) {
    types::annotate(referenceOf(name), typeof(value))
    types::annotate(referenceOf(name), typeof(annotation))
    types::restrictTo(referenceOf(name), typeof(annotation))
    types::annotate(self, types::typeof(referenceOf(name)))
    types::annotate(referenceOf(name), types::typeof(self))
}

export operation parameterType(name, annotation) {
    types::annotate(referenceOf(name), typeof(annotation))
    types::restrictTo(referenceOf(name), typeof(annotation))
    types::annotate(self, types::typeof(referenceOf(name)))
    types::annotate(referenceOf(name), types::typeof(self))
}

export operation referenceType(name) {
    types::annotate(self, types::typeof(referenceOf(name)))
    types::annotate(referenceOf(name), types::typeof(self))
}

export operation functionSignature(name, arguments, body, annotation) {
    types::annotate(self, Function)
    types::annotate(referenceOf(name), Function)
    types::annotate((referenceOf(name), parameters), types::typeof(arguments))
    types::annotate(arguments, types::typeof((referenceOf(name), parameters)))
    types::annotate((referenceOf(name), returnType), types::typeof((body, returnType)))
    types::annotate((referenceOf(name), returnType), typeof(annotation))
    types::restrictTo((referenceOf(name), returnType), typeof(annotation))
}

export operation call(callee, arguments) {
    types::restrictTo(callee, Function)
    types::annotate(self, types::resolveWith((referenceOf(callee), returnType), [((referenceOf(callee), parameters), types::typeof(arguments))]))
}
