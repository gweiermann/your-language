import { types } from "std/types"
import { unknown, functionTypeSymbol } from "./types"
import { lexicalScope } from "std/variables"
import { Whitespace } from "./lexical"
import { FunctionDeclaration, FunctionBody } from "./function"
import { LetDeclaration } from "./let"

node Program = statements: (FunctionDeclaration | LetDeclaration)* {
    meanings {
        types(unknown, functionTypeSymbol) boundary
        lexicalScope() precedence {
            FunctionDeclaration > LetDeclaration > FunctionBody
        }
    }
}

entry Program {
    trivia Whitespace
}
