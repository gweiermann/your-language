import { annotateWithType, inheritType, typeof } from "./typing"

export symbol number

export symbol string

export symbol boolean

export symbol parameters

export symbol parameterNames

export symbol parameterAnnotations

export symbol parameterSources

export symbol returnType

export symbol functionIdentity

export node TypeName {
    node NumberType = "number" {
        meanings {
            annotateWithType(number)
        }
    }

    node StringType = "string" {
        meanings {
            annotateWithType(string)
        }
    }

    node BooleanType = "boolean" {
        meanings {
            annotateWithType(boolean)
        }
    }

    meanings {
        inheritType()
    }
}

export node Annotation =
    ":"
    value: TypeName
{
    meanings {
        annotateWithType(typeof(value))
    }
}

export symbol declaredReturnType
