import { lexicalScope, declare } from "std/references"
import * as types from "std/types"
import { returnType, Annotation } from "./types"
import { typeof, functionSignature } from "./typing"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { Parameter } from "./parameter"
import { Expression } from "./expression"
import { LetDeclaration } from "./let"

export node FunctionBody =
    "{"
    locals: LetDeclaration*
    "return"
    result: Expression
    ";"
    "}"
{
    meanings {
        boundary
        types::annotate((self, returnType), typeof(result))
    }
}

pattern FunctionContents =
    "("
    parameters: Parameter* |> separatedBy(",")
    ")"
    annotation: Annotation?
    body: FunctionBody
{
    meanings {
        lexicalScope(self)
    }
}

export node FunctionDeclaration =
    "function"
    name: Name
    contents: FunctionContents
{
    meanings {
        group Register {
            declare(self, name, reassignable = false)
            functionSignature(name, contents.parameters, contents.body, contents.annotation, contents)
        }
    }
}
