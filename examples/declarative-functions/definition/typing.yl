import { get, contribute, equal, hypothetical, isPresent, lookup, map, text, zip } from "std/query"
import { enclosingScope, referenceOf } from "../../../stdlib/references"
import { type, parameterNames, parameterTypes, returnType, functionIdentity } from "./types"

export operation typeOf(value) = get((value, type))

operation functionOf(scope) = get((scope, functionIdentity))

operation parameterTypesOf(function) = get((function, parameterTypes))

operation parameterNamesOf(function) = get((function, parameterNames))

operation argumentTypes(arguments) = map(arguments, argument => typeOf(argument))

operation sameLength(left, right) = equal(map(left, value => true), map(right, value => true))

operation callAssumptions(function, arguments) = [((function, parameterTypes), zip(parameterNamesOf(function), argumentTypes(arguments)))]

export operation annotateWithType(target, value) {
    contribute((target, type), value)
}

export operation parameterType(target, name) {
    contribute((referenceOf(name), type), lookup(parameterTypesOf(functionOf(enclosingScope(target))), text(name)))
}

export operation callType(target, callee, arguments) {
    if isPresent(referenceOf(callee)) {
        if !sameLength(parameterNamesOf(referenceOf(callee)), arguments) {
            error("Wrong number of arguments", callee)
        }
        else {
            contribute((target, type), hypothetical((referenceOf(callee), returnType), callAssumptions(referenceOf(callee), arguments)))
        }
    }
}
