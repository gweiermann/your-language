import { separatedBy } from "std/parser"
import { contribute, children, first } from "core/query"
import { connectReference, referenceOf } from "../../../stdlib/references"
import { number, string, type } from "./types"
import { annotateWithType, typeOf, callType } from "./typing"
import { Name } from "./lexical"

export node Expression {
    semantics {
        contribute((self, type), typeOf(first(children(self))))
    }
    node Number = /[0-9]+/ {
        semantics {
            annotateWithType(self, number)
        }
    }

    node String = /"[^"\n]*"/ {
        semantics {
            annotateWithType(self, string)
        }
    }

    node Call =
        callee: Reference
        "("
        arguments: Expression* |> separatedBy(",")
        ")"
    {
        semantics {
            callType(self, callee, arguments)
        }
    }

    node Reference = name: Name {
        semantics {
            connectReference(self, name)
            annotateWithType(self, typeOf(referenceOf(name)))
        }
    }
}
