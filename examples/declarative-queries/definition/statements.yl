import { declare, lexicalScope, use } from "../../../stdlib/references"
import { Name } from "./lexical"

export node Statement {
    node Declaration =
        "let"
        name: Name
        ";"
    {
        meanings {
            declare(self, name)
        }
    }

    node Reference =
        name: Name
        ";"
    {
        meanings {
            use(self, name)
        }
    }

    node Block =
        "{"
        statements: Statement*
        "}"
    {
        meanings {
            boundary
            lexicalScope(self)
            precedence {
                Statement::Declaration > Statement::Reference
            }
        }
    }
}
