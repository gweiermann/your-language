import { connectReference } from "std/references"
import { Name } from "./lexical"
import { FunctionExpression } from "./function"

node Reference = name: Name {
    semantics {
        group Resolve {
            connectReference(self, name)
        }
    }
}

export node Expression {
    node FunctionExpression

    node Reference

    node Number = value: /[0-9]+/
}

export node ExpressionDeclaration = value: Expression
