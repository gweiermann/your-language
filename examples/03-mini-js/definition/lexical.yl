import { boundedBy } from "std/parser"

export trivia Whitespace = /[ \t\r\n]+/

export trivia Comment {
    ide {
        highlightAs "comment"
    }
    trivia Line = /\/\/[^\n]*/

    trivia Block = /\/\*[\s\S]*?\*\//
}

pattern IdentifierPart = /[_a-zA-Z0-9]/

export pattern keyword(value) = value |> boundedBy(IdentifierPart) {
    ide {
        highlightAs "keyword"
    }
}

export node Name = value: /[_a-zA-Z][_a-zA-Z0-9]*/ {
    ide {
        highlightAs "variable"
    }
}
