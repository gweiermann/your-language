import * as types from "std/types"
import { children, first as firstChild, contribute } from "std/query"

symbol number

symbol string

symbol output

trivia Whitespace = /\s+/

node Parameter = "value"

node Number = /[0-9]+/ {
    meanings {
        types::annotate(self, number)
    }
}

node String = /"[^"\n]*"/ {
    meanings {
        types::annotate(self, string)
    }
}

node RequiredNumber = "number" {
    meanings {
        types::annotate(self, number)
    }
}

node Argument {
    node Number

    node String

    meanings {
        types::annotate(self, types::typeof(firstChild(children(self))))
    }
}

node Template =
    "identity"
    "("
    local: Parameter
    ")"
{
    meanings {
        types::annotate((self, output), types::typeof(local))
    }
}

operation resultWith(template, parameter, argument) = types::resolveWith((template, output), [(parameter, types::typeof(argument))])

node Program =
    template: Template
    firstArgument: Argument
    secondArgument: Argument
    required: RequiredNumber
{
    meanings {
        types::annotate(firstArgument, resultWith(template, template.local, firstArgument))
        types::restrictTo(firstArgument, types::typeof(required), firstArgument)
        contribute("first", resultWith(template, template.local, firstArgument))
        contribute("second", resultWith(template, template.local, secondArgument))
    }
}

entry Program {
    trivia Whitespace
}
