import * as types from "std/types"
import { children, first as firstChild, contribute } from "core/query"

symbol number

symbol string

symbol output

trivia Whitespace = /\s+/

node Parameter = "value"

node Number = /[0-9]+/ {
    semantics {
        types::annotateWithType(self, number)
    }
}

node String = /"[^"\n]*"/ {
    semantics {
        types::annotateWithType(self, string)
    }
}

node RequiredNumber = "number" {
    semantics {
        types::annotateWithType(self, number)
    }
}

node Argument {
    node Number

    node String

    semantics {
        types::annotateWithType(self, types::typeOf(firstChild(children(self))))
    }
}

node Template =
    "identity"
    "("
    local: Parameter
    ")"
{
    semantics {
        types::annotateWithType((self, output), types::typeOf(local))
    }
}

operation resultWith(template, parameter, argument) = types::resolveTypeWith((template, output), [(parameter, types::typeOf(argument))])

node Program =
    template: Template
    firstArgument: Argument
    secondArgument: Argument
    required: RequiredNumber
{
    semantics {
        types::annotateWithType(firstArgument, resultWith(template, template.local, firstArgument))
        types::restrictTypeTo(firstArgument, types::typeOf(required), firstArgument)
        contribute("first", resultWith(template, template.local, firstArgument))
        contribute("second", resultWith(template, template.local, secondArgument))
    }
}

entry Program {
    trivia Whitespace
}
