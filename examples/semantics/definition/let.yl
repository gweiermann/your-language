import { declare } from "std/variables"
import { Name } from "./lexical"
import { ExpressionDeclaration } from "./expression"
import { FunctionBody } from "./function"

export node LetDeclaration =
    "let" name: Name "="
    initializer: ExpressionDeclaration ";"
{
    meanings {
        group Register {
            declare(name)
        }

        precedence {
            ExpressionDeclaration > LetDeclaration > FunctionBody
        }
    }
}

