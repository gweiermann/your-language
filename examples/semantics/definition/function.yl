import { lexicalScope, declare } from "std/variables"
import { separatedBy } from "std/parser"
import { Name } from "./lexical"
import { Expression } from "./expression"
import { LetDeclaration } from "./let"

node Parameter = name: Name {
    meanings {
        declare(self, name)
    }
}

export node FunctionBody =
    "{"
    locals: LetDeclaration*
    "return"
    result: Expression
    ";"
    "}"
{
    meanings {
        boundary
    }
}

pattern FunctionContents =
    "("
    parameters: Parameter* |> separatedBy(",")
    ")"
    body: FunctionBody
{
    meanings {
        lexicalScope(self)
    }
}

export node FunctionExpression =
    "function"
    contents: FunctionContents

export node FunctionDeclaration =
    "function"
    name: Name
    contents: FunctionContents
{
    meanings {
        group Register {
            declare(self, name, reassignable = false)
        }
    }
}
