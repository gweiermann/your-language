import { lexicalScope } from "std/semantics"
import { Whitespace } from "./lexical"
import { ExpressionDeclaration } from "./expression"
import { FunctionDeclaration, FunctionBody } from "./function"
import { TopLevelDeclaration } from "./let"

node Program =
    statements: (FunctionDeclaration | TopLevelDeclaration)*
{
    meanings {
        lexicalScope()

        precedence {
            FunctionDeclaration > ExpressionDeclaration
            FunctionDeclaration > TopLevelDeclaration > FunctionBody
        }
    }
}

entry Program {
    trivia Whitespace
}
