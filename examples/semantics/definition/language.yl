import { lexicalScope } from "std/variables"
import { Whitespace } from "./lexical"
import { ExpressionDeclaration } from "./expression"
import { FunctionDeclaration, FunctionBody } from "./function"
import { LetDeclaration } from "./let"

node Program =
    statements: (FunctionDeclaration | LetDeclaration)*
{
    meanings {
        boundary
        lexicalScope()

        precedence {
            FunctionDeclaration > ExpressionDeclaration
            FunctionDeclaration > LetDeclaration > FunctionBody
        }
    }
}

entry Program {
    trivia Whitespace
}
