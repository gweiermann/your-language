import { lexicalScope, declare, variable, function, use } from "std/semantics"
import { separatedBy } from "std/parser"
import { Name, Whitespace } from "./lexical"

node Reference =
    name: Name
{
    meanings {
        group Resolve {
            use(name)
        }
    }
}

node Parameter =
    name: Name
{
    meanings {
        declare(variable, name)
    }
}

node Expression {
    node FunctionExpression

    node Reference

    node Number =
        value: /[0-9]+/
}

node ExpressionDeclaration =
    value: Expression

node LetDeclaration =
    "let" name: Name "="
    initializer: ExpressionDeclaration ";"
{
    meanings {
        group Register {
            declare(variable, name)
        }

        precedence {
            ExpressionDeclaration > LetDeclaration
        }
    }
}

node FunctionBody =
    "{"
    locals: LetDeclaration*
    "return" result: Expression ";"
    "}"

pattern FunctionContents =
    "("
    parameters: Parameter* |> separatedBy(",")
    ")"
    body: FunctionBody
{
    meanings {
        lexicalScope()
    }
}

node FunctionExpression =
    "function" contents: FunctionContents

node FunctionDeclaration =
    "function" name: Name contents: FunctionContents
{
    meanings {
        group Register {
            declare(function, name, reassignable=false)
        }
    }
}

pattern TopLevelDeclaration =
    LetDeclaration

node Program =
    statements: (FunctionDeclaration | TopLevelDeclaration)*
{
    meanings {
        lexicalScope()

        precedence {
            FunctionDeclaration > ExpressionDeclaration
            FunctionDeclaration > TopLevelDeclaration > FunctionBody
        }
    }
}

entry Program {
    trivia Whitespace
}
