import { isPresent } from "core/query"
import { declareName } from "std/references"
import { Name } from "./lexical"
import { Annotation } from "./types"
import { Expression } from "./expression"
import { annotateWithType, evidenceOf, typeOf, compareTypes, Comparison, reportDifference } from "./typing"

export node LetDeclaration =
    "let"
    name: Name
    annotation: Annotation?
    "="
    initializer: Expression
    ";"
{
    semantics {
        declareName(self, name)
        item := evidenceOf(initializer)
        annotateWithType(self, item[0], item[1], item[2])
        when isPresent(annotation) {
            differences := compareTypes(item, typeOf(annotation), Comparison::assignable)
            when isPresent(differences[0]) {
                reportDifference(differences[0], [annotation.value, initializer])
            }
        }
    }
}
