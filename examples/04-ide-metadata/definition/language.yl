// Experimental representative examples compose through normal grammar.
import { separatedBy } from "std/parser"

trivia Whitespace = /\s+/

pattern Name = /[a-z]+/ {
    ide {
        example "name"
        highlightAs "variable"
    }
}

node Number = /[0-9]+/ {
    ide {
        example "42"
        highlightAs "number"
    }
}

node Program =
    "let"
    Name
    "="
    Number
    ";"

node List = Number* |> separatedBy(",")

entry Program {
    trivia Whitespace
}
