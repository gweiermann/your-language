import { createLexicalScope } from "../../../stdlib/references"
import { Whitespace } from "./lexical"
import { FunctionDeclaration } from "./function"
import { Expression } from "./expression"

node Statement {
    node FunctionDeclaration

    node ExpressionStatement =
        value: Expression
        ";"
}

node Program = statements: Statement* {
    semantics {
        boundary
        createLexicalScope(self)
        precedence {
            FunctionDeclaration::semantics::Register > Expression
        }
    }
}

entry Program {
    trivia Whitespace
}
