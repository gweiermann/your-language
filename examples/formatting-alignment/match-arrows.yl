import { error } from "core/diagnostics"

// Formatting illustration only: operation names illustrate a type-policy match.
node Addition =
    left: /[0-9]+/
    "+"
    right: /[0-9]+/
{
    semantics {
        match (typeOf(left), typeOf(right)) {
            string, string | string, number | number, string => type(string)
            number, number                                   => type(number)
            unknown, _ | _, unknown                          => type(unknown)
            _                                                => error("Unsupported operands")
        }
    }
}

entry Addition
