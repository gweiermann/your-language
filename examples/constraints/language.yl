import { error, warn } from "core/diagnostics"

node Program =
    name: /[A-Za-z]+/?
    ":"
{
    checks {
        when name?.matches(/^[A-Z]/) {
            warn("Names should begin with a lowercase letter.")
        }
        when !name.isPresent() {
            error("A name is required.")
        }
    }
}

entry Program
