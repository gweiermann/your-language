{
  "name": "your-language",
  "displayName": "Your Language",
  "description": "YL syntax highlighting, live diagnostics, formatting and example hints.",
  "version": "0.2.2",
  "publisher": "gweiermann",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/gweiermann/your-language.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available. The language server requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "yl",
        "aliases": [
          "Your Language",
          "YL"
        ],
        "extensions": [
          ".yl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yl",
        "scopeName": "source.yl",
        "path": "./syntaxes/yl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Your Language",
      "properties": {
        "yourLanguage.cliPath": {
          "type": "string",
          "default": "yl",
          "scope": "machine-overridable",
          "description": "YL executable path or name on PATH, without arguments. Requires the lsp command."
        },
        "yourLanguage.exampleEntry": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute language entry .yl path for import-graph validation and example hints. Open modules declaring entry are detected automatically; unsaved buffers are supported."
        },
        "yourLanguage.exampleDisplay": {
          "type": "string",
          "enum": [
            "above",
            "inline",
            "off"
          ],
          "default": "above",
          "scope": "window",
          "description": "Display parser-validated examples above declarations as clickable CodeLens (copy full example), inline as inlay hints, or hide them. Above requires editor.codeLens enabled."
        }
      }
    },
    "commands": [
      {
        "command": "yourLanguage.copyExample",
        "title": "Your Language: Copy Example"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yourLanguage.copyExample",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "grammar": "node scripts/sync-grammar.cjs",
    "build": "npm run grammar && tsc -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "vsce package --skip-license --out your-language.vsix",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
