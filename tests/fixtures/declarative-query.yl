import { ancestors, contribute, find, get, isPresent } from "core/query"

symbol scope

symbol result

node Name = value: /[a-z]+/

node Program = name: Name {
    semantics {
        contribute((self, scope), self)
        when isPresent(find(ancestors(name), ancestor => get((ancestor, scope)))) {
            contribute((name, result), find(ancestors(name), ancestor => get((ancestor, scope))))
        }
    }
}

entry Program
