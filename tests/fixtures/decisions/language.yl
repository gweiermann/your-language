import { error, warn, hint } from "core/diagnostics"

enum Mode {
    a
    b
}

pipe wrap(first: Mode, second: Mode) {
    rewrite value match (first, second) {
        (.a, .a) => "(" value ")"
        (.a, .b) => {
            error("This combination is not allowed.")
        }
        _ => {
            warn("Pipe not applied; preserving input.") value
        }
    }
}

node Program =
    name: /[A-Za-z]+/?
    ":"
    items: /x/* |> wrap(.b, .a)
{
    checks {
        when name?.matches(/^[A-Z]/) {
            warn("Capitalized name.")
        }
        when !name?.matches(/^[A-Z]/) {
            hint("Lowercase name.")
        }
        when name?.matches(/^[A-Z]/) == absent {
            hint("Missing name.")
        }
        when name.isPresent() && name.matches(/^X/) {
            warn("X name.")
        }
    }
}

entry Program
