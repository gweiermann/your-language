{
  "version": 1,
  "entry": "language.yl#Program",
  "rules": {
    "language.yl#Program": {
      "name": "Program",
      "trivia": false,
      "body": {
        "Concrete": {
          "Sequence": [
            {
              "Capture": [
                "name",
                {
                  "Repeat": [
                    {
                      "Regex": "[A-Za-z]+"
                    },
                    "Optional"
                  ]
                }
              ]
            },
            {
              "Literal": ":"
            },
            {
              "Capture": [
                "items",
                {
                  "Project": {
                    "id": 0,
                    "term": {
                      "Mark": {
                        "id": 0,
                        "term": {
                          "Repeat": [
                            {
                              "Regex": "x"
                            },
                            "Star"
                          ]
                        }
                      }
                    },
                    "quantifier": "Star",
                    "collect_lists": true
                  }
                }
              ]
            }
          ]
        }
      },
      "constraints": [
        {
          "condition": {
            "OptionalMatches": {
              "capture": "name",
              "regex": "^[A-Z]"
            }
          },
          "emissions": [
            {
              "severity": "warning",
              "message": "Capitalized name.",
              "span": {
                "file": "language.yl",
                "start": 522,
                "end": 547
              }
            }
          ]
        },
        {
          "condition": {
            "Not": {
              "OptionalMatches": {
                "capture": "name",
                "regex": "^[A-Z]"
              }
            }
          },
          "emissions": [
            {
              "severity": "help",
              "message": "Lowercase name.",
              "span": {
                "file": "language.yl",
                "start": 610,
                "end": 633
              }
            }
          ]
        },
        {
          "condition": {
            "Equal": [
              {
                "OptionalMatches": {
                  "capture": "name",
                  "regex": "^[A-Z]"
                }
              },
              "Absent"
            ]
          },
          "emissions": [
            {
              "severity": "help",
              "message": "Missing name.",
              "span": {
                "file": "language.yl",
                "start": 705,
                "end": 726
              }
            }
          ]
        },
        {
          "condition": {
            "And": [
              {
                "Present": "name"
              },
              {
                "Matches": {
                  "capture": "name",
                  "regex": "^X"
                }
              }
            ]
          },
          "emissions": [
            {
              "severity": "warning",
              "message": "X name.",
              "span": {
                "file": "language.yl",
                "start": 803,
                "end": 818
              }
            }
          ]
        }
      ],
      "span": {
        "file": "language.yl",
        "start": 378,
        "end": 836
      }
    }
  },
  "trivia": []
}
